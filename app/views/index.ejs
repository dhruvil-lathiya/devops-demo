<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= nodeLabel %> | DevOps Demo</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0f172a;
      color: #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
    }
    .card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 12px;
      padding: 48px;
      text-align: center;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
      max-width: 420px;
      width: 90%;
    }
    .node-label {
      font-size: 3rem;
      font-weight: 700;
      color: #38bdf8;
      margin-bottom: 8px;
      letter-spacing: -1px;
    }
    .version {
      font-size: 1.25rem;
      color: #22d3ee;
      background: #0e3a4f;
      display: inline-block;
      padding: 4px 16px;
      border-radius: 20px;
      margin-bottom: 24px;
    }
    .meta {
      font-size: 0.85rem;
      color: #64748b;
      margin-top: 16px;
    }
    .divider {
      border: none;
      border-top: 1px solid #334155;
      margin: 24px 0;
    }
    .status {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: #4ade80;
      font-size: 0.9rem;
    }
    .status-dot {
      width: 8px;
      height: 8px;
      background: #4ade80;
      border-radius: 50%;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="node-label"><%= nodeLabel %></div>
    <div class="version"><%= version %></div>
    <hr class="divider">
    <div class="status">
      <span class="status-dot"></span>
      Running
    </div>
    <div class="meta">Container: <%= hostname %></div>
  </div>
</body>
</html>
